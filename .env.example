APP_TIMEZONE=Asia/Jakarta
PUBLIC_BASE_URL=https://example.com
WEBHOOK_PATH=/webhook
CRON_TICK_SECONDS=60
DAILY_RECAP_TIME=00:00
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=15

# =============================================================
# Telegram
# =============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_SECRET=

# =============================================================
# Google Sheets
# =============================================================
SHEETS_SPREADSHEET_ID=
GOOGLE_CREDENTIALS_JSON=
GOOGLE_SCOPE=https://www.googleapis.com/auth/spreadsheets
SHEETS_API_BASE_URL=https://sheets.googleapis.com
SHEETS_CACHE_TTL_SECONDS=60
SHEET_AUTO_CREATE=true
SHEET_NAME_SCHEDULES=schedules
SHEET_NAME_PROGRESS=progress_logs
SHEET_NAME_REMINDER_STATE=reminder_state
SHEET_NAME_PROGRESS_ARCHIVE=progress_archive
SHEET_ARCHIVE_ENABLED=true
PROGRESS_RETENTION_DAYS=90
REMINDER_RETENTION_DAYS=7
SHEETS_MAX_RETRIES=4
SHEETS_RETRY_BASE_MS=500

# =============================================================
# AI
# =============================================================
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.3
AI_JSON_RETRIES=2

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.1-flash-lite

# =============================================================
# Prompts
# =============================================================
PROMPTS_DIR=./prompts
PROMPTS_HOT_RELOAD=true

# Alasan/impian user untuk system_chat. Isi di .env, jangan commit.
USER_CONTEXT=
